 // ---- draws --------------------------------------------------------------------------------------
+void preload_programs() {
+    if (opt.shader_cache.empty()) return;
+    std::error_code ec;
+    std::filesystem::directory_iterator it(opt.shader_cache + "/sources", ec), end;
+    if (ec) return;
+    auto t0 = std::chrono::steady_clock::now();
+    unsigned n = 0, linked = 0;
+    for (; it != end; it.increment(ec)) {
+        if (it->path().extension() != ".src") continue;
+        FILE* f = std::fopen(it->path().string().c_str(), "rb");
+        if (!f) continue;
+        std::string source;
+        char buf[65536];
+        for (size_t k; (k = std::fread(buf, 1, sizeof buf, f)) > 0;) source.append(buf, k);
+        std::fclose(f);
+        size_t cut = source.find('\0');
+        if (cut == std::string::npos || programs_by_source.count(source)) continue;
+        uint64_t hash = source_hash(source);
+        GLuint p = load_program(hash);
+        if (!p) {
+            if (!(p = link(source.substr(0, cut), source.substr(cut + 1)))) continue;
+            save_program(p, hash);
+            linked++;
+        }
+        programs_by_source.emplace(std::move(source), p);
+        n++;
+    }
+    rt_log("video: %u programs ready before play (%u linked now) in %.2f s", n, linked,
+           std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());
+}
