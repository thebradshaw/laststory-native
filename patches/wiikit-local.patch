+uint64_t mix64(uint64_t h, uint64_t v) {
+    h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    return h * 0xFF51AFD7ED558CCDull;
+}
+float f32(uint32_t w) { float f; std::memcpy(&f, &w, 4); return f; }
+uint32_t u32(float f) { uint32_t w; std::memcpy(&w, &f, 4); return w; }
+
+// The halfway frame's matrices: halfway between the frame before's (a, as
+// mid_matrices' layout: XI_POS words of matrix memory, XI_NRM of normal
+// matrices, the projection) and the current XF's; each matrix kept as it
+// is where the two are far apart. a null: the current ones.
+const uint32_t* mid_matrices(const uint32_t* a) {
+    static uint32_t out[XI_WORDS];
+    uint32_t* b = out;
+    std::memcpy(b, &xf[0], XI_POS * 4);
+    std::memcpy(b + XI_POS, &xf[0x400], XI_NRM * 4);
+    std::memcpy(b + XI_POS + XI_NRM, &xf[0x1020], XI_PRJ * 4);
+    if (!a) return out;
+    auto lerp = [&](uint32_t i) { b[i] = u32((f32(a[i]) + f32(b[i])) * 0.5f); };
+    auto finite = [](float v) { return v == v && std::fabs(v) < 1e30f; };
+    // 3x4 matrices, 12 words each (the position matrices on multiples of 3 rows; texture ones too, near enough)
+    for (uint32_t g = 0; g + 12 <= XI_POS; g += 12) {
+        float rs = 0, dr = 0, ta[3], tb[3];
+        bool ok = true;
+        for (int r = 0; r < 3; ++r) {
+            for (int c = 0; c < 3; ++c) {
+                float x = f32(a[g + r * 4 + c]), y = f32(b[g + r * 4 + c]);
+                ok = ok && finite(x) && finite(y);
+                rs = std::max(rs, std::fabs(y));
+                dr = std::max(dr, std::fabs(x - y));
+            }
+            ta[r] = f32(a[g + r * 4 + 3]);
+            tb[r] = f32(b[g + r * 4 + 3]);
+            ok = ok && finite(ta[r]) && finite(tb[r]);
+        }
+        if (!ok || dr > 0.25f * rs + 1e-6f) continue;
+        float dt = std::sqrt((ta[0] - tb[0]) * (ta[0] - tb[0]) + (ta[1] - tb[1]) * (ta[1] - tb[1]) + (ta[2] - tb[2]) * (ta[2] - tb[2]));
+        float tl = std::max(std::sqrt(ta[0] * ta[0] + ta[1] * ta[1] + ta[2] * ta[2]),
+                            std::sqrt(tb[0] * tb[0] + tb[1] * tb[1] + tb[2] * tb[2]));
+        if (dt > 0.25f * tl + 0.05f * rs) continue;
+        for (uint32_t i = g; i < g + 12; ++i) lerp(i);
+    }
+    for (uint32_t g = XI_POS; g + 9 <= XI_POS + XI_NRM; g += 9) {   // normal matrices, 3x3
+        float rs = 0, dr = 0;
+        for (uint32_t i = g; i < g + 9; ++i) {
+            rs = std::max(rs, std::fabs(f32(b[i])));
+            dr = std::max(dr, std::fabs(f32(a[i]) - f32(b[i])));
+        }
+        if (dr <= 0.35f * rs + 1e-6f) for (uint32_t i = g; i < g + 9; ++i) lerp(i);
+    }
+    uint32_t p = XI_POS + XI_NRM;                                  // the projection, of one kind in both
+    if (a[p + 6] == b[p + 6]) {
+        float rs = 0, dr = 0;
+        for (uint32_t i = p; i < p + 6; ++i) {
+            rs = std::max(rs, std::fabs(f32(b[i])));
+            dr = std::max(dr, std::fabs(f32(a[i]) - f32(b[i])));
+        }
+        if (dr <= 0.25f * rs) for (uint32_t i = p; i < p + 6; ++i) lerp(i);
+    }
+    return out;
+}
