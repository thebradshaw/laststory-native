+// The programs' sources, kept beside the binaries (shadercache/sources): a
+// binary is the driver's, a source is anyone's. Every program linked leaves
+// its source there, and at start every source there is made a program
+// (from its binary, or linked and its binary kept): what was drawn once, on
+// this machine or on the one that made the list, costs nothing in play.
+uint64_t plain_hash(const std::string& source) {
+    uint64_t h = 0xCBF29CE484222325ull;
+    for (unsigned char ch : source) h = (h ^ ch) * 0x100000001B3ull;
+    return h;
+}
+void save_source(const std::string& source) {
+    if (opt.shader_cache.empty()) return;
+    std::error_code ec;
+    std::filesystem::create_directories(opt.shader_cache + "/sources", ec);
+    char name[40];
+    std::snprintf(name, sizeof name, "/sources/%016llx.src", (unsigned long long)plain_hash(source));
+    std::string path = opt.shader_cache + name;
+    if (std::filesystem::exists(path, ec)) return;
+    if (FILE* f = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(source.data(), 1, source.size(), f);
+        std::fclose(f);
+    }
+}
