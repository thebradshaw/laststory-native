+// A frame complete (its XFB copy just made): its halfway frame drawn from
+// its record, then the record kept as the frame before.
+int show_put(const Tex& t) {
+    ds_valid = false;
+    int k = show_next;
+    show_next = (show_next + 1) % SHOW_RING;
+    Tex& d = show_ring[k];
+    ensure_tex(d, t.w, t.h, 1);
+    static GLuint show_fbo = 0;
+    if (!show_fbo) glCreateFramebuffers(1, &show_fbo);
+    glNamedFramebufferTexture(copy_fbo, GL_COLOR_ATTACHMENT0, t.name, 0);
+    glNamedFramebufferTexture(show_fbo, GL_COLOR_ATTACHMENT0, d.name, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glBlitNamedFramebuffer(copy_fbo, show_fbo, 0, 0, t.w, t.h, 0, 0, t.w, t.h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    showq.push_back(k);
+    while (showq.size() > 3) { showq.pop_front(); ++ist.dropped; }
+    return k;
+}
