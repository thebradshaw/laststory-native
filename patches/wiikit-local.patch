+// Large textures in bands of tile rows, side by side: the rows of tiles
+// are independent, and a level of a big texture decodes in a fraction of
+// the time on the game's thread (loading hitches).
+void gxtex_decode_parallel(uint32_t fmt, int w, int h, const uint8_t* src, uint8_t* rgba, const uint8_t* tlut,
+                           uint32_t tlut_fmt) {
+    static const int workers = (int)std::clamp(std::thread::hardware_concurrency(), 1u, 8u);
+    Block b = block(fmt);
+    int tile_rows = (h + b.h - 1) / b.h, tiles_wide = (w + b.w - 1) / b.w;
+    int bands = std::min(workers, tile_rows);
+    if (bands < 2 || (size_t)w * h < 256 * 256) { gxtex_decode(fmt, w, h, src, rgba, tlut, tlut_fmt); return; }
+    int per = (tile_rows + bands - 1) / bands;
+    std::vector<std::thread> threads;
+    auto band = [=](int k) {
+        int r0 = k * per, r1 = std::min(tile_rows, r0 + per);
+        if (r0 >= r1) return;
+        int y0 = r0 * b.h, hh = std::min(h, r1 * b.h) - y0;
+        gxtex_decode(fmt, w, hh, src + (size_t)r0 * tiles_wide * b.bytes, rgba + (size_t)y0 * w * 4, tlut, tlut_fmt);
+    };
+    for (int k = 1; k < bands; ++k) threads.emplace_back(band, k);
+    band(0);
+    for (auto& t : threads) t.join();
+}
