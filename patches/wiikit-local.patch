+// The halfway frame's vertices: positions, normals, texture coordinates and
+// colours halfway, where the
+// draw's vertices moved on the CPU and not too far for its size.
+bool mid_vertices(const uint8_t* a, const uint8_t* b, uint32_t npieces, std::vector<uint8_t>& out) {
+    size_t len = 0;
+    for (uint32_t i = 0, k; i < npieces; ++i) {
+        std::memcpy(&k, b + len, 4);
+        len += 4 + (size_t)k * sizeof(GVtx);
+    }
+    if (!std::memcmp(a, b, len)) return false;                   // nothing moved
+    float lo[3] = {1e30f, 1e30f, 1e30f}, hi[3] = {-1e30f, -1e30f, -1e30f}, d = 0;
+    for (size_t off = 0, i = 0; i < npieces; ++i) {
+        uint32_t k, ka;
+        std::memcpy(&k, b + off, 4);
+        std::memcpy(&ka, a + off, 4);
+        if (k != ka) return false;
+        off += 4;
+        for (uint32_t v = 0; v < k; ++v, off += sizeof(GVtx)) {
+            const GVtx *va = reinterpret_cast<const GVtx*>(a + off), *vb = reinterpret_cast<const GVtx*>(b + off);
+            if (std::memcmp(va->mtx, vb->mtx, sizeof vb->mtx)) return false;
+            for (int c = 0; c < 3; ++c) {
+                lo[c] = std::min(lo[c], vb->pos[c]);
+                hi[c] = std::max(hi[c], vb->pos[c]);
+                d = std::max(d, std::fabs(va->pos[c] - vb->pos[c]));
+            }
+        }
+    }
+    float size = std::max({hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]});
+    if (!(d <= 1.0f * size)) return false;                     // a jump (a particle born again): not lerped
+    out.assign(b, b + len);
+    for (size_t off = 0, i = 0; i < npieces; ++i) {
+        uint32_t k;
+        std::memcpy(&k, b + off, 4);
+        off += 4;
+        for (uint32_t v = 0; v < k; ++v, off += sizeof(GVtx)) {
+            const GVtx* va = reinterpret_cast<const GVtx*>(a + off);
+            GVtx* vo = reinterpret_cast<GVtx*>(out.data() + off);
+            for (int c = 0; c < 3; ++c) {
+                vo->pos[c] = (va->pos[c] + vo->pos[c]) * 0.5f;
+                vo->nrm[c] = (va->nrm[c] + vo->nrm[c]) * 0.5f;
+            }
+            for (int t = 0; t < 8; ++t)                      // scrolled texture coordinates, not ones that wrapped
+                for (int c = 0; c < 2; ++c)
+                    if (std::fabs(va->tc[t][c] - vo->tc[t][c]) < 0.25f) vo->tc[t][c] = (va->tc[t][c] + vo->tc[t][c]) * 0.5f;
+            for (int k = 0; k < 2; ++k)
+                for (int c = 0; c < 4; ++c) vo->col[k][c] = (uint8_t)((va->col[k][c] + vo->col[k][c] + 1) / 2);
+        }
+    }
+    return true;
+}
